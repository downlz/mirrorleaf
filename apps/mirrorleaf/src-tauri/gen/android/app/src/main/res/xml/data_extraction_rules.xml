<?xml version="1.0" encoding="utf-8"?>
<!-- Notes stay on the person's own devices (the core idea): nothing of
     Mirrorleaf's goes into Android's cloud backup or a phone-to-phone
     transfer (M11). A new phone joins with a code or the recovery kit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>

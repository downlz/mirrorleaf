# Copy to `.env` in this folder (never committed), then fill in.

# Letters and digits only: it goes into a connection URL.
# One way to make one: openssl rand -hex 16
POSTGRES_PASSWORD=

# Leave empty until the Firebase project exists: pushes are then only logged.
# With a key in ./secrets, set:
# FCM_SERVICE_ACCOUNT=/secrets/fcm-service-account.json
FCM_SERVICE_ACCOUNT=

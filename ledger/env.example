# Copy to `.env` in this folder (never committed), then fill in.

# Letters and digits only: it goes into a connection URL.
# One way to make one: openssl rand -hex 16
POSTGRES_PASSWORD=

# Leave empty until the Firebase project exists: pushes are then only logged.
# With a key in ./secrets, set:
# FCM_SERVICE_ACCOUNT=/secrets/fcm-service-account.json
FCM_SERVICE_ACCOUNT=

# Where the ledger's port is published. The default keeps it on this machine
# (Caddy or a tunnel reaches it there). For a phone on the same Wi-Fi during
# development: LEDGER_PUBLISH=8080
LEDGER_PUBLISH=127.0.0.1:8080

# The domains Caddy serves the ledger and the relay on with HTTPS (`--profile
# https`). Their DNS must point at this machine, with ports 80 and 443 (TCP)
# and 7842 (UDP, the relay's address check) open. `localhost` and
# `relay.localhost` use Caddy's own local certificate authority, for testing
# on this machine. For Mirrorleaf's server:
# LEDGER_DOMAIN=ledger.mirrorleaf.app
# RELAY_DOMAIN=relay.mirrorleaf.app
LEDGER_DOMAIN=localhost
RELAY_DOMAIN=relay.localhost

# Behind your own web server instead of Caddy (nginx with a certbot
# certificate, as on Mirrorleaf's server): run `--profile relay`, and give the
# relay the certificate's files for its UDP 7842 address check.
# RELAY_CERTS=/etc/letsencrypt
# RELAY_CERT_FILE=/certs/live/<certificate name>/fullchain.pem
# RELAY_KEY_FILE=/certs/live/<certificate name>/privkey.pem
# RELAY_PUBLISH=127.0.0.1:3340

# The relay devices are told to use (M13). For Mirrorleaf's server:
# LEDGER_RELAY_URL=https://relay.mirrorleaf.app
# For `--profile relay` on a home network: http://<this machine's address>:3340
# (with RELAY_PUBLISH=3340).
LEDGER_RELAY_URL=

# The dashboard (M13): this machine only by default; reach it with
# `ssh -L 8081:127.0.0.1:8081 <server>` and http://localhost:8081. Or set it
# to the server's Tailscale address, e.g. DASHBOARD_PUBLISH=100.64.0.5:8081.
# Never an address the internet can reach.
DASHBOARD_PUBLISH=127.0.0.1:8081

# Request limits; leave empty for the defaults, 0 turns a limit off.
# Signed requests per device per minute (default 30).
LEDGER_DEVICE_REQUESTS_PER_MINUTE=
# New accounts per minute across the ledger (default 20). After the database
# is replaced every device registers again: raise this or set 0 for a while.
LEDGER_NEW_ACCOUNTS_PER_MINUTE=

# Protections for a ledger anyone may use (M13); empty for the defaults.
# The sign-up puzzle's difficulty while sign-ups are quiet (default 21, about
# a second on a phone; each +1 doubles the work; 0 turns it off).
LEDGER_PUZZLE_BITS=
# Per address and hour, kept in memory only (defaults 30, 120 and 30; 0 off).
LEDGER_SIGN_UPS_PER_HOUR_PER_IP=
LEDGER_LOOKUPS_PER_HOUR_PER_IP=
LEDGER_PASSES_PER_HOUR_PER_IP=
# What each device may send through the relay per second, and its burst
# (defaults 1000000 and 4000000 bytes).
RELAY_CLIENT_BYTES_PER_SECOND=
RELAY_CLIENT_BURST_BYTES=

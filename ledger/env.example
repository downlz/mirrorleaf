# Copy to `.env` in this folder (never committed), then fill in.

# Letters and digits only: it goes into a connection URL.
# One way to make one: openssl rand -hex 16
POSTGRES_PASSWORD=

# Leave empty until the Firebase project exists: pushes are then only logged.
# With a key in ./secrets, set:
# FCM_SERVICE_ACCOUNT=/secrets/fcm-service-account.json
FCM_SERVICE_ACCOUNT=

# Where the ledger's port is published. The default keeps it on this machine
# (Caddy or a tunnel reaches it there). For a phone on the same Wi-Fi during
# development: LEDGER_PUBLISH=8080
LEDGER_PUBLISH=127.0.0.1:8080

# The domain Caddy serves the ledger on with HTTPS (`--profile https`). Its DNS
# must point at this machine, with ports 80 and 443 open. `localhost` uses
# Caddy's own local certificate authority, for testing on this machine.
LEDGER_DOMAIN=localhost

# Request limits; leave empty for the defaults, 0 turns a limit off.
# Signed requests per device per minute (default 30).
LEDGER_DEVICE_REQUESTS_PER_MINUTE=
# New accounts per minute across the ledger (default 20). After the database
# is replaced every device registers again: raise this or set 0 for a while.
LEDGER_NEW_ACCOUNTS_PER_MINUTE=
